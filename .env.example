# Copy to .env and fill in. Never commit the real .env file.

# production on the live server
NODE_ENV=development
PORT=4000

# The public address of the site, used in sitemap.xml and share previews
SITE_URL=http://localhost:5173

# MongoDB connection (MongoDB Atlas free tier works). Local default shown.
MONGODB_URI=mongodb://127.0.0.1:27017/hawk-academe

# Long random string for signing admin sessions: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Email for Contact-form enquiries, sent through Brevo's API (Settings > SMTP & API > API Keys).
# MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
MAIL_FROM="HAwk ACademe Website <no-reply@hawkacademe.com>"
# Fallback recipient if no enquiry email is set in Admin > Timings & highlights
ENQUIRY_TO=

# Photo storage for production (Cloudinary free plan): cloudinary://KEY:SECRET@CLOUD_NAME
# Leave empty to store photos in the local uploads/ folder (development only).
CLOUDINARY_URL=
# Or instead: CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET

# Optional: Google Analytics 4 (G-XXXXXXXXXX) and Search Console / Bing Webmaster
# verification codes (only the content="..." value). Leave empty to turn off.
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional extra spam protection on the Contact form (Cloudflare Turnstile, free)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
