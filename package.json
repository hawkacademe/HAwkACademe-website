{
  "name": "hawk-academe-website",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "nodemon --watch server server/start.js",
    "dev:web": "vite",
    "build": "node tools/check-brand.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "start": "NODE_ENV=production node server/start.js",
    "seed": "node server/scripts/seed.js",
    "create-admin": "node server/scripts/create-admin.js",
    "remove-admin": "node server/scripts/remove-admin.js",
    "check:placeholders": "node tools/check-placeholders.mjs",
    "test": "node --test test/",
    "check:brand": "node tools/check-brand.mjs",
    "check:seo": "node tools/seo-check.mjs"
  },
  "license": "UNLICENSED",
  "description": "HAwk ACademe website (Pro plan): React front end, Express API, MongoDB, admin panel.",
  "dependencies": {
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.4",
    "htmlparser2": "^12.0.0",
    "nodemon": "^3.1.14",
    "vite": "^8.3.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
